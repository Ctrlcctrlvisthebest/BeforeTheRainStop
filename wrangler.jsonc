{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "before-the-rain-rooms",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RainRoom" },
      { "name": "LEADERBOARDS", "class_name": "RainLeaderboard" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RainRoom"] },
    { "tag": "v2-leaderboards", "new_sqlite_classes": ["RainLeaderboard"] },
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "SCORE_SUBMISSION_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "ROOM_CREATION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "ROOM_REQUEST_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,https://ctrlcctrlvisthebest.github.io,https://caicaili205-collab.github.io,https://www.bilibili.com,https://www.bilibilitoy.com",
  },
}
